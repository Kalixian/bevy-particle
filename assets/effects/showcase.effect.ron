// Every other demo emitter at once, pulled toward the center and kept in a box.
(
    space: (capacity: 1000000),
    gravity: (strength: 15.0, softening: 23.0, method: BarnesHut, theta: 0.5),
    attractor: (strength: Constant(2000000.0), max_accel: Constant(400.0)),
    modifiers: [
        PointAttractor(
            offset: Constant((0.0, 0.0)),
            strength: Constant(300000.0),
            max_accel: Constant(100.0),
        ),
        Bounds(
            half_extents: Constant((3620.0, 3340.0)),
            restitution: Constant(0.5),
        ),
    ],
    emitters: [
        (source: File("cluster.emitter.ron")),
        (source: File("stream.emitter.ron"), position: (-450.0, -150.0)),
        (source: File("keyframes.emitter.ron"), position: (-400.0, 200.0)),
    ],
)
