// Fish that turn to face where they swim (textures do when `stretch` is above 0), with a
// four-frame tail beat. Hold the mouse to scatter them.
(
    space: (capacity: 150000),
    render: (stretch: 0.004, texture: (path: "/textures/fish.png", columns: 4, playback: Fps(9.0))),
    attractor: (strength: Constant(-12000000.0), max_accel: Constant(1800.0)),
    modifiers: [
        Drag(Constant(0.55)),
        Bounds(half_extents: Constant((625.0, 345.0)), restitution: Constant(0.8)),
        Alpha(Scale, Track((clock: Life, keys: [(time: 0.0, value: 0.0), (time: 0.08, value: 1.0), (time: 0.92, value: 1.0), (time: 1.0, value: 0.0)]))),
    ],
    emitters: [
        // The big blue shoal follows a wandering point.
        (position: (-250.0, 0.0), source: Inline((
            emitter: (
                burst_count: 70000, rate: 5000.0, lifetime: (from: 6.0, to: 22.0),
                spawn_half_extents: (300.0, 200.0), speed: (from: 40.0, to: 130.0),
                radius: (from: 2.0, to: 6.0, shape: Falloff(5.0)),
                red: (from: 0.2, to: 0.4), green: (from: 0.6, to: 0.95), blue: (from: 0.9, to: 1.2),
                alpha: (from: 0.7, to: 1.0),
            ),
            modifiers: [
                PointAttractor(offset: Track((clock: Time, repeat: PingPong, keys: [(time: 0.0, value: (-150.0, -80.0), ease: Smooth), (time: 3.0, value: (450.0, 130.0), ease: Smooth), (time: 6.0, value: (100.0, -150.0), ease: Smooth), (time: 9.0, value: (500.0, -100.0), ease: Smooth)])), strength: Constant(5000000.0), max_accel: Constant(130.0)),
                Vortex(offset: Constant((250.0, 0.0)), strength: Constant(22000.0), max_accel: Constant(110.0)),
            ],
        ))),
        // The orange one wanders the other way.
        (position: (250.0, 0.0), source: Inline((
            emitter: (
                burst_count: 45000, rate: 3214.0, lifetime: (from: 6.0, to: 22.0),
                spawn_half_extents: (300.0, 200.0), speed: (from: 40.0, to: 130.0),
                radius: (from: 2.0, to: 6.0, shape: Falloff(5.0)),
                red: (from: 1.0, to: 1.4), green: (from: 0.35, to: 0.7), blue: (from: 0.05, to: 0.2),
                alpha: (from: 0.7, to: 1.0),
            ),
            modifiers: [
                PointAttractor(offset: Track((clock: Time, repeat: PingPong, keys: [(time: 0.0, value: (100.0, 120.0), ease: Smooth), (time: 4.0, value: (-600.0, -120.0), ease: Smooth), (time: 7.0, value: (-300.0, 180.0), ease: Smooth)])), strength: Constant(5000000.0), max_accel: Constant(150.0)),
                Vortex(offset: Constant((-250.0, 0.0)), strength: Constant(-26000.0), max_accel: Constant(130.0)),
            ],
        ))),
    ],
)
