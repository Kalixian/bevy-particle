// Petals tumbling on a breeze. Each spins from a random rotation and flips through a looping sprite sheet; eddies and a sideways
// sway carry them, and many settle on the ground before fading.
(
    space: (capacity: 160000),
    render: (texture: (path: "/textures/petals.png", columns: 4, rows: 4, playback: Fps(14.0))),
    attractor: (strength: Constant(-6000000.0), max_accel: Constant(900.0)),
    modifiers: [
        Acceleration(Track((clock: Time, repeat: PingPong, keys: [(time: 0.0, value: (60.0, -70.0), ease: Smooth), (time: 2.0, value: (170.0, -10.0), ease: Smooth), (time: 4.0, value: (20.0, -80.0), ease: Smooth)]))),
        // Each petal also sways in its own time.
        Acceleration(Track((clock: Seconds, repeat: PingPong, keys: [(time: 0.0, value: (-70.0, 8.0), ease: Smooth), (time: 1.3, value: (70.0, -8.0), ease: Smooth)]))),
        Vortex(offset: Constant((-250.0, 60.0)), strength: Constant(-9000.0), max_accel: Constant(140.0)),
        Vortex(offset: Constant((330.0, -80.0)), strength: Constant(9000.0), max_accel: Constant(140.0)),
        Drag(Constant(0.9)),
        Bounds(half_extents: Constant((800.0, 352.0)), restitution: Constant(0.1)),
        Alpha(Scale, Track((clock: Life, keys: [(time: 0.0, value: 0.0), (time: 0.04, value: 1.0), (time: 0.8, value: 1.0), (time: 1.0, value: 0.0)]))),
    ],
    emitters: [
        (source: Inline((emitter: (
            rate: 7000.0, lifetime: (from: 5.0, to: 12.0),
            spawn_half_extents: (790.0, 345.0), speed: (from: 5.0, to: 60.0),
            radius: (from: 2.0, to: 7.0, shape: Falloff(5.0)),
            red: (from: 1.0, to: 1.0), green: (from: 0.45, to: 0.82), blue: (from: 0.6, to: 0.88),
            alpha: (from: 0.6, to: 1.0), rotation: (from: 0.0, to: 6.2832), spin: (from: -1.5, to: 1.5),
        )))),
        // Blown in from the left.
        (position: (-780.0, 0.0), source: Inline((emitter: (
            rate: 6000.0, lifetime: (from: 5.0, to: 10.0),
            spawn_half_extents: (10.0, 340.0), speed: (from: 100.0, to: 420.0),
            angle: (from: -0.2, to: 0.5),
            radius: (from: 2.0, to: 5.0, shape: Falloff(4.0)),
            red: (from: 0.95, to: 1.0), green: (from: 0.75, to: 0.95), blue: (from: 0.8, to: 0.95),
            alpha: (from: 0.6, to: 1.0), rotation: (from: 0.0, to: 6.2832), spin: (from: -1.5, to: 1.5),
        )))),
    ],
)
