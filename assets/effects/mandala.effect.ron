// Outlines that shed streaks of light: petals from ellipses, stars from squares, and
// counter-turning rings. A streak's rotation sets it across its motion like the barbs of a
// feather, and spin twirls it.
(
    space: (capacity: 450000),
    render: (blend: Additive, softness: 1.0, stretch: 0.09),
    attractor: (strength: Constant(-4000000.0), max_accel: Constant(700.0)),
    modifiers: [
        Vortex(
            offset: Constant((0.0, 0.0)),
            strength: Track((clock: Time, repeat: PingPong, keys: [(time: 0.0, value: -9000.0, ease: Smooth), (time: 4.0, value: 9000.0, ease: Smooth)])),
            max_accel: Constant(60.0),
        ),
        Drag(Constant(0.4)),
        Alpha(Scale, Track((clock: Life, keys: [(time: 0.0, value: 0.0), (time: 0.12, value: 1.0), (time: 1.0, value: 0.0)]))),
        Color(Scale, Track((clock: Time, repeat: Loop, keys: [(time: 0.0, value: (1.0, 1.0, 1.0), ease: Smooth), (time: 4.0, value: (1.5, 0.7, 1.1), ease: Smooth), (time: 8.0, value: (0.6, 1.1, 1.5), ease: Smooth), (time: 12.0, value: (1.0, 1.0, 1.0), ease: Smooth)]))),
    ],
    emitters: [
        // The heart.
        (source: Inline((
            emitter: (
                rate: 12000.0, lifetime: (from: 1.2, to: 2.8),
                spawn: Ring(radius: (from: 0.0, to: 36.0)),
                direction: Outward, angle: (from: 0.5, to: 0.7), speed: (from: 20.0, to: 70.0),
                rotation: (from: 1.5708, to: 1.5708), spin: (from: -1.0, to: 1.0),
                radius: (from: 0.6, to: 2.2, shape: Falloff(5.0)),
                red: (from: 2.5, to: 3.5), green: (from: 1.6, to: 2.2), blue: (from: 0.5, to: 0.9), alpha: (from: 0.04, to: 0.12),
            ),
        ))),
        // Six petals: three ellipses, each shedding inward.
        (source: Inline((
            emitter: (
                rate: 16000.0, lifetime: (from: 1.2, to: 2.8),
                spawn: Ellipse(radii: (190.0, 62.0), fill: Edge),
                direction: Normal, angle: (from: 2.9, to: 3.38), speed: (from: 8.0, to: 45.0),
                rotation: (from: 1.5708, to: 1.5708), spin: (from: -0.4, to: 0.4),
                radius: (from: 0.6, to: 2.2, shape: Falloff(5.0)),
                red: (from: 2.2, to: 3.0), green: (from: 0.3, to: 0.7), blue: (from: 1.0, to: 1.6), alpha: (from: 0.04, to: 0.12),
            ),
        ))),
        (rotation: 1.0472, source: Inline((
            emitter: (
                rate: 16000.0, lifetime: (from: 1.2, to: 2.8),
                spawn: Ellipse(radii: (190.0, 62.0), fill: Edge),
                direction: Normal, angle: (from: 2.9, to: 3.38), speed: (from: 8.0, to: 45.0),
                rotation: (from: 1.5708, to: 1.5708), spin: (from: -0.4, to: 0.4),
                radius: (from: 0.6, to: 2.2, shape: Falloff(5.0)),
                red: (from: 2.2, to: 3.0), green: (from: 0.3, to: 0.7), blue: (from: 1.0, to: 1.6), alpha: (from: 0.04, to: 0.12),
            ),
        ))),
        (rotation: 2.0944, source: Inline((
            emitter: (
                rate: 16000.0, lifetime: (from: 1.2, to: 2.8),
                spawn: Ellipse(radii: (190.0, 62.0), fill: Edge),
                direction: Normal, angle: (from: 2.9, to: 3.38), speed: (from: 8.0, to: 45.0),
                rotation: (from: 1.5708, to: 1.5708), spin: (from: -0.4, to: 0.4),
                radius: (from: 0.6, to: 2.2, shape: Falloff(5.0)),
                red: (from: 2.2, to: 3.0), green: (from: 0.3, to: 0.7), blue: (from: 1.0, to: 1.6), alpha: (from: 0.04, to: 0.12),
            ),
        ))),
        // Two squares make an eight-pointed star; light runs along their sides.
        (source: Inline((
            emitter: (
                rate: 22000.0, lifetime: (from: 1.2, to: 2.8),
                spawn: Rect(half_extents: (178.0, 178.0), fill: Edge),
                direction: Normal, angle: (from: 1.1, to: 1.4), speed: (from: 15.0, to: 60.0),
                rotation: (from: 0.0, to: 0.0), spin: (from: -0.6, to: 0.6),
                radius: (from: 0.6, to: 2.2, shape: Falloff(5.0)),
                red: (from: 0.3, to: 0.7), green: (from: 1.2, to: 1.8), blue: (from: 2.4, to: 3.2), alpha: (from: 0.04, to: 0.12),
            ),
        ))),
        (rotation: 0.7854, source: Inline((
            emitter: (
                rate: 22000.0, lifetime: (from: 1.2, to: 2.8),
                spawn: Rect(half_extents: (178.0, 178.0), fill: Edge),
                direction: Normal, angle: (from: 1.1, to: 1.4), speed: (from: 15.0, to: 60.0),
                rotation: (from: 0.0, to: 0.0), spin: (from: -0.6, to: 0.6),
                radius: (from: 0.6, to: 2.2, shape: Falloff(5.0)),
                red: (from: 0.3, to: 0.7), green: (from: 1.2, to: 1.8), blue: (from: 2.4, to: 3.2), alpha: (from: 0.04, to: 0.12),
            ),
        ))),
        // Rings that turn against each other.
        (source: Inline((
            emitter: (
                rate: 24000.0, lifetime: (from: 1.2, to: 2.8),
                spawn: Ring(radius: (from: 276.0, to: 282.0)),
                direction: Outward, angle: (from: 1.3, to: 1.5), speed: (from: 30.0, to: 90.0),
                rotation: (from: 0.0, to: 0.0), spin: (from: 0.0, to: 0.0),
                radius: (from: 0.6, to: 2.2, shape: Falloff(5.0)),
                red: (from: 1.0, to: 1.6), green: (from: 0.5, to: 0.9), blue: (from: 2.4, to: 3.2), alpha: (from: 0.04, to: 0.12),
            ),
        ))),
        (source: Inline((
            emitter: (
                rate: 24000.0, lifetime: (from: 1.2, to: 2.8),
                spawn: Ring(radius: (from: 312.0, to: 318.0)),
                direction: Outward, angle: (from: -1.8, to: -1.6), speed: (from: 30.0, to: 90.0),
                rotation: (from: 0.4, to: 0.4), spin: (from: 0.0, to: 0.8),
                radius: (from: 0.6, to: 2.2, shape: Falloff(5.0)),
                red: (from: 2.4, to: 3.2), green: (from: 1.3, to: 1.9), blue: (from: 0.4, to: 0.8), alpha: (from: 0.04, to: 0.12),
            ),
        ))),
    ],
)
