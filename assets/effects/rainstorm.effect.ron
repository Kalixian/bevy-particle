// Layers of rain, each drop stretched into a streak, that bounces off the ground. Gusts bend
// all of it, and lightning (hard cuts in a looping color track) lights it up.
(
    space: (capacity: 700000),
    render: (blend: Additive, softness: 0.3, stretch: 0.028),
    attractor: (strength: Constant(-9000000.0), max_accel: Constant(2500.0)),
    modifiers: [
        Acceleration(Track((clock: Time, repeat: PingPong, keys: [(time: 0.0, value: (-60.0, -520.0), ease: Smooth), (time: 3.0, value: (620.0, -480.0), ease: Smooth), (time: 5.0, value: (-560.0, -520.0), ease: Smooth)]))),
        Color(Scale, Track((clock: Time, repeat: Loop, keys: [
            (time: 0.0, value: (0.8, 0.8, 0.8), ease: Step),
            (time: 3.4, value: (6.0, 6.0, 8.0), ease: Step),
            (time: 3.46, value: (0.8, 0.8, 0.8), ease: Step),
            (time: 3.56, value: (9.0, 8.0, 11.0)),
            (time: 4.1, value: (0.8, 0.8, 0.8), ease: Step),
            (time: 6.9, value: (4.0, 4.0, 6.0)),
            (time: 7.3, value: (0.8, 0.8, 0.8)),
        ]))),
        Alpha(Scale, Track((clock: Life, keys: [(time: 0.0, value: 0.0), (time: 0.05, value: 1.0), (time: 0.85, value: 1.0), (time: 1.0, value: 0.0)]))),
    ],
    emitters: [
        // Far away: fine and dim.
        (position: (0.0, 400.0), source: Inline((
            emitter: (
                rate: 110000.0,
                lifetime: (from: 0.9, to: 1.45),
                spawn_half_extents: (900.0, 40.0),
                speed: (from: 420.0, to: 620.0),
                angle: (from: -1.72, to: -1.6),
                radius: (from: 0.25, to: 0.6),
                red: (from: 0.45, to: 0.6), green: (from: 0.65, to: 0.8), blue: (from: 1.0, to: 1.3),
                alpha: (from: 0.04, to: 0.16),
            ),
            // The emitter is above the screen; this puts the floor at the bottom of it.
            modifiers: [Bounds(half_extents: Constant((1200.0, 750.0)), restitution: Constant(0.2))],
        ))),
        // Nearby: fast and bright.
        (position: (0.0, 400.0), source: Inline((
            emitter: (
                rate: 30000.0,
                lifetime: (from: 0.6, to: 1.05),
                spawn_half_extents: (900.0, 40.0),
                speed: (from: 700.0, to: 950.0),
                angle: (from: -1.72, to: -1.6),
                radius: (from: 0.5, to: 1.0),
                red: (from: 0.45, to: 0.6), green: (from: 0.65, to: 0.8), blue: (from: 1.0, to: 1.3),
                alpha: (from: 0.15, to: 0.5),
            ),
            // The emitter is above the screen; this puts the floor at the bottom of it.
            modifiers: [Bounds(half_extents: Constant((1200.0, 750.0)), restitution: Constant(0.2))],
        ))),
    ],
)
